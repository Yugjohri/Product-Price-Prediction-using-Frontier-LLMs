# Copy to .env and fill in. Never commit the real .env.

# --- required for the live demo ---
# Free tier: https://console.groq.com/keys
# This is the ONLY key the deployed app ever receives.
GROQ_API_KEY=

# --- local benchmarking only, never deployed ---
# Used by benchmarks/run_openai_prompted.py. The public demo cannot reach this
# key: premium models are gated behind bring-your-own-key.
OPENAI_API_KEY=

# Not required. The dataset (ed-donner/items_lite) is public and loads
# anonymously; only pushing your own dataset to the Hub would need a token.
HF_TOKEN=
